# 复制本文件为 .env，然后把下面的中文占位内容改成你自己的配置。
#
# 示例：
# cp .env.example .env


# =============================
# LLM Provider
# =============================

# 可选值：
# online = 使用线上 OpenAI 兼容接口
# local  = 使用本地 mlx_lm.server
LLM_PROVIDER=online


# =============================
# Online LLM
# =============================

# 阿里百炼 / DashScope API Key，请替换为你自己的密钥。
DASHSCOPE_API_KEY=请填写你的阿里百炼API_KEY

# OpenAI 兼容接口地址，请替换为你的服务地址。
# 注意：这里填写到 /v1 即可，程序会自动拼接 /chat/completions。
ONLINE_LLM_BASE_URL=请填写你的OpenAI兼容接口地址

# 线上模型名称，请按需替换。
ONLINE_LLM_MODEL=请填写线上LLM模型名称

# 是否使用流式接口。建议保持 true。
ONLINE_LLM_STREAM=true

# 是否开启 thinking。语音助手低延迟场景建议 false。
ONLINE_LLM_ENABLE_THINKING=false


# =============================
# LLM Generation
# =============================

LLM_TEMPERATURE=0.6
LLM_MAX_TOKENS=100
